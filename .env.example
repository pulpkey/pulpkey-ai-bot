# Agent runtime (Vercel)
# Vercel deployments can use the automatically provisioned OIDC token. For
# local development, create an AI Gateway key and set it here.
AI_GATEWAY_API_KEY=
# Optional. Defaults to Claude Sonnet. Set any Vercel AI Gateway model ID to
# switch providers without changing code, e.g. `openai/gpt-5`.
AI_MODEL=anthropic/claude-sonnet-4.6
# Optional cost-free readiness mode. Set to true to exercise the full WhatsApp
# bridge without making any model calls. Remove or set false when ready.
AI_DISABLED=false

# PostgreSQL/Supabase/Neon connection used by the private server-side tools.
DATABASE_URL=postgresql://user:password@host:5432/pulpkey
DATABASE_SSL=true

# Shared secret and public Railway bridge URL. The secret must exactly match
# bridge/WHATSAPP_BRIDGE_SECRET.
WHATSAPP_BRIDGE_SECRET=replace-with-at-least-32-random-characters
BRIDGE_URL=https://your-pulpkey-whatsapp-bridge.up.railway.app
BRIDGE_TIMEOUT_MS=4000

# Comma-separated admin WhatsApp JIDs allowed to update durable group memory.
MEMORY_ADMIN_JIDS=

# Optional research/document capabilities.
FIRECRAWL_API_KEY=

